{
  "$schema": "./packages/builders-native/schema/angular-native-schema.json",
  "version": 1,
  "cli": {
    "packageManager": "pnpm"
  },
  "newProjectRoot": "examples",
  "projects": {
    "ng-linux-counter": {
      "projectType": "application",
      "schematics": {},
      "root": "examples/counter-app",
      "sourceRoot": "examples/counter-app/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "examples/counter-app/src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "examples/counter-app/public"
              }
            ],
            "styles": ["examples/counter-app/src/styles.css"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "native": {
          "builder": "@ng-desktop/builders:application",
          "options": {
            "os": "linux",
            "arch": "x86_64"
          },
          "configurations": {
            "linux-arm64": {
              "os": "linux",
              "arch": "aarch64"
            },
            "windows-x64": {
              "os": "windows",
              "arch": "x86_64"
            },
            "macos-universal": {
              "os": "macos",
              "arch": "universal"
            }
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "ng-linux-counter:build:production"
            },
            "development": {
              "buildTarget": "ng-linux-counter:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "tsconfig.spec.json",
            "include": ["**/*.spec.ts", "../../../packages/**/*.spec.ts"],
            "coverageReporters": ["text-summary", "lcov", "json-summary"],
            "coverageThresholds": {
              "statements": 75,
              "branches": 62,
              "functions": 72,
              "lines": 75
            }
          }
        }
      }
    },
    "ng-desktop-docs": {
      "projectType": "application",
      "schematics": {},
      "root": "docs-site",
      "sourceRoot": "docs-site/src",
      "prefix": "docs",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "index": "docs-site/src/index.html",
            "browser": "docs-site/src/main.ts",
            "tsConfig": "docs-site/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "docs-site/public"
              }
            ],
            "styles": ["docs-site/src/styles.css"]
          },
          "configurations": {
            "production": {
              "baseHref": "/ng-desktop-engine/",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "750kB",
                  "maximumError": "1.5MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "12kB",
                  "maximumError": "24kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "baseHref": "/",
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "ng-desktop-docs:build:production"
            },
            "development": {
              "buildTarget": "ng-desktop-docs:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "docs-site/tsconfig.spec.json",
            "include": ["**/*.spec.ts"],
            "coverageInclude": ["docs-site/src/**/*.ts"],
            "coverageReporters": ["text-summary", "lcov", "json-summary"],
            "coverageThresholds": {
              "statements": 78,
              "branches": 63,
              "functions": 44,
              "lines": 76
            }
          }
        }
      }
    }
  }
}
