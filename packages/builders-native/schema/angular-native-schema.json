{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ng-desktop://config/angular-native-schema.json",
  "title": "Angular + NgDesktop Extended Workspace Configuration",
  "description": "Extends the official Angular CLI workspace schema with minimal native desktop OS, CPU architecture, and packaging configuration.",
  "allOf": [
    {
      "$ref": "../../../node_modules/@angular/cli/lib/config/schema.json"
    },
    {
      "type": "object",
      "properties": {
        "projects": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "architect": {
                "type": "object",
                "properties": {
                  "native": {
                    "type": "object",
                    "properties": {
                      "builder": {
                        "type": "string",
                        "enum": [
                          "@ng-desktop/builders:application",
                          "@ng-desktop/builders:build",
                          "@ng-desktop/builders:engine",
                          "@ng-desktop/builders:dev-server"
                        ]
                      },
                      "options": {
                        "$ref": "./native-builder-schema.json"
                      },
                      "configurations": {
                        "type": "object",
                        "additionalProperties": {
                          "$ref": "./native-builder-schema.json"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
