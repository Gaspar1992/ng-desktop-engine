{
  "name": "ng-linux-counter",
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "dev": "node packages/builders-native/src/dev-server.mjs",
    "start": "ng serve",
    "build": "ng build && node packages/builders-native/src/build-bundle.mjs",
    "build:native": "node packages/builders-native/src/build-bundle.mjs",
    "build:packages": "node scripts/build-packages.mjs",
    "build:engine-packages": "node scripts/build-engine-packages.mjs",
    "package:linux": "pnpm run build && cargo run -- --package",
    "package:all": "pnpm run build && cargo run -- --package-all",
    "watch": "ng build --watch --configuration development",
    "watch:native": "node packages/builders-native/src/build-bundle.mjs --watch",
    "test": "ng test",
    "test:pack": "node scripts/test-external-pack.mjs",
    "test:rust": "cargo test",
    "test:containers": "bash scripts/test-containers.sh",
    "lint": "oxlint . && eslint .",
    "lint:ox": "oxlint .",
    "lint:eslint": "eslint .",
    "lint:rust": "cargo clippy --all-targets -- -D warnings",
    "format": "oxfmt .",
    "format:all": "oxfmt . && cargo fmt --all",
    "format:check": "oxfmt --check .",
    "check": "pnpm run format:check && pnpm run lint && pnpm run test --watch=false && cargo fmt --all -- --check && cargo clippy --all-targets -- -D warnings && cargo test"
  },
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "dependencies": {
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/forms": "^22.2.6",
    "@angular/platform-browser": "^22.2.6",
    "@angular/router": "^22.2.6",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "^22.7.0",
    "@angular-eslint/eslint-plugin-template": "^22.7.0",
    "@angular-eslint/template-parser": "^22.7.0",
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.6",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "angular-eslint": "^22.7.0",
    "eslint": "^10.15.0",
    "eslint-plugin-oxlint": "^1.94.0",
    "jsdom": "^31.0.1",
    "oxc-parser": "^0.159.0",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
